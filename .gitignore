*.docx
*.pdf

# Prometheus: бинарники и TSDB-данные не коммитим
prometheus/prometheus-*/
prometheus/data/
prometheus/*.zip
prometheus/*.log

# Временные файлы
.tmp-edge-profile/
*.tmp
pip-*/
tmp*/
__pycache__/
*.pyc
.ipynb_checkpoints/
artifacts/*.log

# Файлы ОС
Thumbs.db
desktop.ini
.DS_Store
